# Apenas arquivos gerados em tempo de execução nesta máquina.

# --- estado desta máquina ---
# Leitura crua do save; a versão saneada vai para docs/.
/progress.json
# Estado dos contadores (com horários de jogo; refeitos se apagados).
/deaths.json
/deaths-mem.json
/bosskills.json
/efeitos.json
sync/.state.json

# --- gerados ---
auditoria-publica.txt
sync/trackeroao.log
sync/trackeroao.log*
# Despejos de memória para localizar offsets (dezenas de MB).
sync/snapshots/
# Cópias da hibernação: contêm o save, com Steam ID.
arquivo/

# --- ambiente ---
node_modules/
sync/offsets.json.bak
redirect/

/selecao.json
# Última abertura de cada jogo vigiado (ordem da tela inicial).
/recentes.json
/biblioteca.json
sync/cache/
sync/.jogo-pasta.json
/jogador.json
# Idioma escolhido na página.
sync/idioma.json
# "Fechar" da bandeja: impede a subida automática do serviço.
sync/fechado.flag
# Marca de abertura manual, lida pela tarefa agendada.
sync/abrir.pedido
# "Iniciar com o Windows" marcado na bandeja.
sync/iniciar-com-windows.flag
# Estado da janela (visível ou na bandeja), lido pela atualização.
sync/janela.estado
docs/celular/ios/build/
